# Required API keys (fill in whichever provider you use)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM provider: "anthropic", "openai", or "ollama"
LLM_PROVIDER=anthropic

# Set to "true" to use local Ollama instead of a paid API
USE_OLLAMA=false

# Ollama model name (only used if USE_OLLAMA=true)
OLLAMA_MODEL=llama3

# Anthropic model (only used if LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenAI model (only used if LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini

# Paths (relative to project root — usually no need to change)
CHROMA_DB_PATH=data/chroma_db
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
LOGS_PATH=logs

# Retrieval settings
TOP_K_VECTOR=10
TOP_K_FINAL=5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=100
